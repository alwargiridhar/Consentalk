{
  "expo": {
    "name": "Consentalk",
    "slug": "consentalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "consentalk",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.consentalk.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Speak your phrase to summon a private room",
        "NSPhotoLibraryUsageDescription": "Share an ephemeral photo in a room",
        "NSCameraUsageDescription": "Optional: capture a moment to share ephemerally"
      }
    },
    "android": {
      "package": "com.consentalk.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0EA5E9"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F0F9FF"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Speak your phrase to summon a private room"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Share an ephemeral photo with a trusted member"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
